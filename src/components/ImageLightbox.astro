---
// Visualizador acionado por qualquer elemento com [data-gallery] na página.
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visualizar foto ampliada"
  hidden
>
  <div class="lightbox-inner">
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="Fechar foto">
      <span aria-hidden="true">×</span>
    </button>
    <button class="lightbox-arrow prev" type="button" data-lightbox-prev aria-label="Foto anterior">
      <span aria-hidden="true">←</span>
    </button>
    <img class="lightbox-image" data-lightbox-image src="" alt="" />
    <button class="lightbox-arrow next" type="button" data-lightbox-next aria-label="Próxima foto">
      <span aria-hidden="true">→</span>
    </button>
    <span class="lightbox-count" data-lightbox-count aria-live="polite"></span>
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgb(15 20 38 / 82%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0.25s;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* O atributo `hidden` tira do fluxo; a transição continua controlada pela classe. */
  .lightbox[hidden] {
    display: none;
  }

  .lightbox-inner {
    position: relative;
    display: grid;
    place-items: center;
    width: min(1060px, 100%);
    max-height: calc(100vh - 48px);
  }

  .lightbox-image {
    width: auto;
    max-width: 100%;
    max-height: calc(100vh - 90px);
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 14px;
    object-fit: contain;
    box-shadow: 0 18px 45px rgb(0 0 0 / 28%);
  }

  .lightbox-close,
  .lightbox-arrow {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 10px;
    background: rgb(255 255 255 / 96%);
    color: var(--ink);
    font-size: 1.25rem;
    box-shadow: var(--shadow-rest);
  }

  .lightbox-close {
    right: 0;
    top: -8px;
  }

  .lightbox-arrow {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-arrow.prev {
    left: 12px;
  }

  .lightbox-arrow.next {
    right: 12px;
  }

  .lightbox-close:hover,
  .lightbox-arrow:hover {
    background: var(--blue);
    color: var(--white);
  }

  .lightbox-count {
    position: absolute;
    left: 50%;
    bottom: -34px;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .lightbox {
      padding: 15px;
    }

    .lightbox-close {
      right: 0;
      top: -48px;
    }

    .lightbox-arrow {
      width: 38px;
      height: 38px;
    }

    .lightbox-arrow.prev {
      left: 4px;
    }

    .lightbox-arrow.next {
      right: 4px;
    }
  }
</style>

<script>
  const lightbox = document.querySelector<HTMLElement>('#lightbox');
  const triggers = [...document.querySelectorAll<HTMLElement>('[data-gallery]')];

  if (lightbox && triggers.length > 0) {
    const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const counter = lightbox.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const closeButton = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    const focusables = [...lightbox.querySelectorAll<HTMLButtonElement>('button')];

    const photos = triggers.map((trigger) => ({
      src: trigger.dataset.gallerySrc ?? '',
      alt: trigger.dataset.galleryAlt ?? '',
    }));

    let index = 0;
    let lastTrigger: HTMLElement | null = null;

    const render = (next: number) => {
      index = (next + photos.length) % photos.length;
      const photo = photos[index]!;
      image.src = photo.src;
      image.alt = photo.alt;
      counter.textContent = `${index + 1} / ${photos.length}`;
    };

    const open = (trigger: HTMLElement, position: number) => {
      lastTrigger = trigger;
      render(position);
      lightbox.hidden = false;
      requestAnimationFrame(() => lightbox.classList.add('is-open'));
      document.body.classList.add('is-locked');
      closeButton.focus();
    };

    const close = () => {
      lightbox.classList.remove('is-open');
      document.body.classList.remove('is-locked');
      window.setTimeout(() => {
        lightbox.hidden = true;
      }, 250);
      lastTrigger?.focus();
    };

    triggers.forEach((trigger, position) => {
      trigger.addEventListener('click', () => open(trigger, position));
    });

    closeButton.addEventListener('click', close);
    lightbox
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => render(index - 1));
    lightbox
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => render(index + 1));

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox.classList.contains('is-open')) return;

      if (event.key === 'Escape') {
        close();
        return;
      }

      if (event.key === 'ArrowLeft') render(index - 1);
      if (event.key === 'ArrowRight') render(index + 1);

      // Mantém o foco dentro do diálogo enquanto ele está aberto.
      if (event.key === 'Tab') {
        const first = focusables[0]!;
        const last = focusables[focusables.length - 1]!;
        const active = document.activeElement;

        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        } else if (!lightbox.contains(active)) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
