---
import logo from '../assets/logo-orbixhub.svg';
import { contact } from '../../site.config';

// Renderizado na build: um ano estático não exige JavaScript no cliente.
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-row">
    <a class="brand" href="#topo" aria-label="Voltar ao início">
      <img src={logo.src} width="30" height="30" alt="" />
      <span>Orbix</span><span>Hub</span>
    </a>

    <p class="footer-copy">© {year} OrbixHub · Dados demonstrativos para apresentação.</p>

    <div class="footer-links">
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href="#duvidas">Dúvidas</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 30px 0;
    border-top: 1px solid var(--line);
    background: var(--white);
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .brand span:last-child {
    color: var(--blue);
  }

  .footer-copy {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-links a:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .footer-row {
      display: block;
    }

    .footer-links {
      margin-top: 14px;
      flex-wrap: wrap;
    }
  }
</style>
