---
import { whatsappHref } from '../../site.config';

// Sem número configurado o botão não é renderizado: o preview apontava para
// `wa.me/?text=...`, um link que abre o WhatsApp sem destino nenhum.
---

{
  whatsappHref && (
    <aside aria-label="Contato rápido">
      <a
        class="whatsapp-float"
        href={whatsappHref}
        target="_blank"
        rel="noopener"
        aria-label="Falar com o OrbixHub pelo WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.53 0 .2 5.32.2 11.87c0 2.09.55 4.13 1.6 5.93L.1 23.9l6.25-1.64a11.86 11.86 0 0 0 5.72 1.47h.01c6.55 0 11.87-5.33 11.87-11.87 0-3.17-1.23-6.14-3.45-8.36ZM12.08 21.7h-.01a9.84 9.84 0 0 1-5.02-1.37l-.36-.21-3.71.98.99-3.62-.23-.37a9.84 9.84 0 0 1-1.51-5.24C2.23 6.44 6.65 2.02 12.08 2.02c2.63 0 5.1 1.03 6.96 2.89a9.77 9.77 0 0 1 2.89 6.96c0 5.43-4.42 9.83-9.85 9.83Zm5.4-7.37c-.3-.15-1.77-.87-2.05-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.74-1.65-2.04-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.68-1.63-.93-2.23-.24-.58-.49-.5-.68-.51h-.58c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.21 5.08 4.5.71.31 1.27.5 1.7.64.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
        </svg>
        <span>Fale conosco</span>
      </a>
    </aside>
  )
}

<style>
  .whatsapp-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 120;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 52px;
    padding: 0 17px;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 999px;
    background: #0e7d45;
    color: #fff;
    box-shadow: 0 8px 24px rgb(15 80 47 / 20%);
    font-size: 0.86rem;
    font-weight: 700;
    transition:
      transform 0.25s var(--ease),
      background 0.25s,
      box-shadow 0.25s;
  }

  .whatsapp-float:hover {
    transform: translateY(-3px);
    background: #0b6b3a;
    box-shadow: 0 12px 28px rgb(15 80 47 / 25%);
  }

  .whatsapp-float svg {
    width: 22px;
    height: 22px;
    fill: currentcolor;
  }

  @media (max-width: 760px) {
    .whatsapp-float {
      right: 15px;
      bottom: 15px;
      width: 52px;
      height: 52px;
      padding: 0;
      justify-content: center;
    }

    .whatsapp-float span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
