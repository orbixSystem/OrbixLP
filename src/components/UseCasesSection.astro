---
import { Image, getImage } from 'astro:assets';

import casoEstoque from '../assets/caso-estoque.webp';
import casoEntrega from '../assets/caso-entrega.webp';
import casoEquipe from '../assets/caso-equipe.webp';

const cases = [
  {
    image: casoEstoque,
    alt: 'Peças automotivas organizadas em prateleiras de uma oficina',
    openLabel: 'Ampliar foto do estoque',
    title: 'Estoque à vista',
    text: 'Peças e mínimos organizados para comprar antes da urgência.',
  },
  {
    image: casoEntrega,
    alt: 'Mecânico entregando a chave do carro ao cliente na oficina',
    openLabel: 'Ampliar foto da entrega do veículo',
    title: 'Cliente informado',
    text: 'O acompanhamento por link reduz interrupções e aumenta confiança.',
  },
  {
    image: casoEquipe,
    alt: 'Equipe de oficina revisando uma ordem de serviço em um tablet',
    openLabel: 'Ampliar foto da equipe alinhada',
    title: 'Time alinhado',
    text: 'Cada pessoa sabe o que precisa fazer e quem acompanha o resultado.',
  },
];

// Versão grande usada só quando a foto é ampliada. O preview reaproveitava o
// `currentSrc` da miniatura, então a imagem abria borrada no lightbox.
const fullSizes = await Promise.all(
  cases.map((item) => getImage({ src: item.image, width: 1200, quality: 72, format: "webp" })),
);
---

<section class="section usecases-section">
  <div class="container">
    <div class="stacked-head">
      <div class="section-heading reveal">
        <p class="eyebrow">Feito para o mundo real</p>
        <h2>Um sistema que aparece em cada canto da operação.</h2>
      </div>
      <p class="lede reveal">
        Do estoque à conversa com o cliente, tudo fica mais fácil de encontrar, atualizar e
        compartilhar.
      </p>
    </div>

    <div class="usecases-grid">
      {
        cases.map((item, index) => (
          <article class:list={['usecase', 'reveal', index > 0 && `reveal-delay-${index}`]}>
            <button
              class="gallery-item"
              type="button"
              aria-label={item.openLabel}
              data-gallery
              data-gallery-src={fullSizes[index]!.src}
              data-gallery-alt={item.alt}
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[240, 420, 640]}
                sizes="(max-width: 760px) 115px, 340px"
                loading="lazy"
              />
            </button>
            <div class="usecase-body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .usecases-section {
    background: var(--white);
  }

  .usecases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 26px;
  }

  .usecase {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--white);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s;
  }

  .usecase:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    height: 170px;
    padding: 0;
    overflow: hidden;
    background: var(--paper);
    cursor: zoom-in;
  }

  .gallery-item::after {
    content: "↗";
    position: absolute;
    right: 12px;
    top: 12px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgb(255 255 255 / 80%);
    border-radius: 8px;
    background: rgb(255 255 255 / 92%);
    color: var(--blue);
    font-weight: 700;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .gallery-item:hover::after,
  .gallery-item:focus-visible::after {
    opacity: 1;
    transform: none;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }

  .gallery-item:hover :global(img) {
    transform: scale(1.035);
  }

  .usecase-body {
    padding: 21px;
  }

  .usecase-body h3 {
    margin-bottom: 8px;
  }

  .usecase-body p {
    font-size: 0.88rem;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .usecases-grid {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 24px;
    }

    .usecase {
      display: grid;
      grid-template-columns: 115px 1fr;
    }

    .gallery-item {
      height: 100%;
      min-height: 135px;
    }

    .usecase-body {
      padding: 16px;
    }

    .usecase-body h3 {
      font-size: 1rem;
    }

    .usecase-body p {
      font-size: 0.8rem;
    }
  }
</style>
